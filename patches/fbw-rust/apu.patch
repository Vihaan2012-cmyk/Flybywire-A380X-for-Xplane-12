 /// This type exists because we don't have a full fuel implementation yet. Once we do, we will
 /// probably move this type and the logic to there.
+/// xp plugin: it now does (fuel.rs's `apu_feed_pressure_psi`, the real
+/// line-141 pressure fuel_network.rs already solves from tank/pump/valve
+/// state), fed in as this same tick's `pressure_psi`; the hysteresis below
+/// is the real >=17/<=16 psi switch this type's own doc always specified.
 pub struct FuelPressureSwitch {
-    has_fuel_remaining: bool,
+    has_pressure: bool,
 }
 impl FuelPressureSwitch {
     fn new() -> Self {
         FuelPressureSwitch {
-            has_fuel_remaining: false,
+            has_pressure: false,
         }
     }

-    fn update(&mut self, has_fuel_remaining: bool) {
-        self.has_fuel_remaining = has_fuel_remaining;
+    fn update(&mut self, pressure_psi: f64) {
+        if pressure_psi >= 17.0 {
+            self.has_pressure = true;
+        } else if pressure_psi <= 16.0 {
+            self.has_pressure = false;
+        }
+        // 16..17 psi: hysteresis band, keep the switch's prior state.
     }

     fn has_pressure(&self) -> bool {
-        self.has_fuel_remaining
+        self.has_pressure
     }
 }
