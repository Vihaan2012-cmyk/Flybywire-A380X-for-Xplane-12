+/// Sensor-realistic inputs computed by the X-Plane plugin's navigation-sensor
+/// physics model (`fbw-xp-systems/src/physics/adirs.rs`; parameters and
+/// equations are in that plugin's `docs/physics/adirs.md`), one instance per
+/// ADIRU (1..=3) so each unit can carry its own gyro/accelerometer bias,
+/// strapdown drift and pitot-static error instead of every ADIRU sharing
+/// X-Plane's single noiseless truth the way [`AdirsSimulatorData`] does.
+///
+/// `valid` is false until the plugin's physics module writes these
+/// variables, which is the case for every existing test in this file and for
+/// any build without that plugin (e.g. the MSFS build): in that case
+/// [`Self::apply_to`] returns its input unchanged, so this struct is purely
+/// additive and never changes existing behaviour.
+#[derive(Clone, Copy)]
+struct AdirsSensedData {
+    valid_id: VariableIdentifier,
+    valid: bool,
+
+    pitch_id: VariableIdentifier,
+    pitch: Angle,
+    roll_id: VariableIdentifier,
+    roll: Angle,
+    true_heading_id: VariableIdentifier,
+    true_heading: Angle,
+    true_track_id: VariableIdentifier,
+    true_track: Angle,
+    body_rotation_rate_x_id: VariableIdentifier,
+    body_rotation_rate_x: AngularVelocity,
+    body_rotation_rate_y_id: VariableIdentifier,
+    body_rotation_rate_y: AngularVelocity,
+    body_rotation_rate_z_id: VariableIdentifier,
+    body_rotation_rate_z: AngularVelocity,
+    latitude_id: VariableIdentifier,
+    latitude: Angle,
+    longitude_id: VariableIdentifier,
+    longitude: Angle,
+    ground_speed_id: VariableIdentifier,
+    ground_speed: Velocity,
+    vertical_speed_id: VariableIdentifier,
+    vertical_speed: Velocity,
+    true_airspeed_id: VariableIdentifier,
+    true_airspeed: Velocity,
+    mach_id: VariableIdentifier,
+    mach: MachNumber,
+    total_air_temperature_id: VariableIdentifier,
+    total_air_temperature: ThermodynamicTemperature,
+    angle_of_attack_id: VariableIdentifier,
+    angle_of_attack: Angle,
+    static_pressure_id: VariableIdentifier,
+    static_pressure: Pressure,
+    computed_airspeed_id: VariableIdentifier,
+    computed_airspeed: Velocity,
+}
+impl AdirsSensedData {
+    fn name(number: usize, field: &str) -> String {
+        format!("ADIRS_SENSED_{number}_{field}")
+    }
+
+    fn new(context: &mut InitContext, number: usize) -> Self {
+        Self {
+            valid_id: context.get_identifier(Self::name(number, "VALID")),
+            valid: false,
+            pitch_id: context.get_identifier(Self::name(number, "PITCH")),
+            pitch: Default::default(),
+            roll_id: context.get_identifier(Self::name(number, "ROLL")),
+            roll: Default::default(),
+            true_heading_id: context.get_identifier(Self::name(number, "TRUE_HEADING")),
+            true_heading: Default::default(),
+            true_track_id: context.get_identifier(Self::name(number, "TRUE_TRACK")),
+            true_track: Default::default(),
+            body_rotation_rate_x_id: context
+                .get_identifier(Self::name(number, "BODY_ROTATION_RATE_X")),
+            body_rotation_rate_x: Default::default(),
+            body_rotation_rate_y_id: context
+                .get_identifier(Self::name(number, "BODY_ROTATION_RATE_Y")),
+            body_rotation_rate_y: Default::default(),
+            body_rotation_rate_z_id: context
+                .get_identifier(Self::name(number, "BODY_ROTATION_RATE_Z")),
+            body_rotation_rate_z: Default::default(),
+            latitude_id: context.get_identifier(Self::name(number, "LATITUDE")),
+            latitude: Default::default(),
+            longitude_id: context.get_identifier(Self::name(number, "LONGITUDE")),
+            longitude: Default::default(),
+            ground_speed_id: context.get_identifier(Self::name(number, "GROUND_SPEED")),
+            ground_speed: Default::default(),
+            vertical_speed_id: context.get_identifier(Self::name(number, "VERTICAL_SPEED")),
+            vertical_speed: Default::default(),
+            true_airspeed_id: context.get_identifier(Self::name(number, "TRUE_AIRSPEED")),
+            true_airspeed: Default::default(),
+            mach_id: context.get_identifier(Self::name(number, "MACH")),
+            mach: Default::default(),
+            total_air_temperature_id: context
+                .get_identifier(Self::name(number, "TOTAL_AIR_TEMPERATURE")),
+            total_air_temperature: ThermodynamicTemperature::new::<degree_celsius>(15.),
+            angle_of_attack_id: context.get_identifier(Self::name(number, "ANGLE_OF_ATTACK")),
+            angle_of_attack: Default::default(),
+            static_pressure_id: context.get_identifier(Self::name(number, "STATIC_PRESSURE")),
+            static_pressure: InternationalStandardAtmosphere::ground_pressure(),
+            computed_airspeed_id: context.get_identifier(Self::name(number, "COMPUTED_AIRSPEED")),
+            computed_airspeed: Default::default(),
+        }
+    }
+
+    /// Returns `data` with every field the plugin's physics model supplies
+    /// replaced by the sensed/strapdown value, or `data` unchanged if the
+    /// physics module has not written anything yet (`valid` false). Used by
+    /// [`AirDataReference`] and [`InertialReference`] as a drop-in
+    /// replacement for the raw simulator truth they otherwise read.
+    fn apply_to(&self, mut data: AdirsSimulatorData) -> AdirsSimulatorData {
+        if self.valid {
+            data.pitch = self.pitch;
+            data.roll = self.roll;
+            data.true_heading = self.true_heading;
+            data.true_track = self.true_track;
+            data.body_rotation_rate_x = self.body_rotation_rate_x;
+            data.body_rotation_rate_y = self.body_rotation_rate_y;
+            data.body_rotation_rate_z = self.body_rotation_rate_z;
+            data.latitude = self.latitude;
+            data.longitude = self.longitude;
+            data.ground_speed = self.ground_speed;
+            data.vertical_speed = self.vertical_speed;
+            data.true_airspeed = self.true_airspeed;
+            data.mach = self.mach;
+            data.total_air_temperature = self.total_air_temperature;
+            data.angle_of_attack = self.angle_of_attack;
+        }
+        data
+    }
+}
+impl SimulationElement for AdirsSensedData {
+    fn read(&mut self, reader: &mut SimulatorReader) {
+        self.valid = reader.read(&self.valid_id);
+        self.pitch = reader.read(&self.pitch_id);
+        self.roll = reader.read(&self.roll_id);
+        self.true_heading = reader.read(&self.true_heading_id);
+        self.true_track = reader.read(&self.true_track_id);
+        // Read as plain degrees per second, like AdirsSimulatorData's own
+        // body rotation rates, rather than the generic AngularVelocity
+        // conversion (revolutions per minute).
+        let x: f64 = reader.read(&self.body_rotation_rate_x_id);
+        let y: f64 = reader.read(&self.body_rotation_rate_y_id);
+        let z: f64 = reader.read(&self.body_rotation_rate_z_id);
+        self.body_rotation_rate_x = AngularVelocity::new::<degree_per_second>(x);
+        self.body_rotation_rate_y = AngularVelocity::new::<degree_per_second>(y);
+        self.body_rotation_rate_z = AngularVelocity::new::<degree_per_second>(z);
+        self.latitude = reader.read(&self.latitude_id);
+        self.longitude = reader.read(&self.longitude_id);
+        self.ground_speed = reader.read(&self.ground_speed_id);
+        // Feet per minute, like AdirsSimulatorData's own vertical_speed.
+        let vertical_speed: f64 = reader.read(&self.vertical_speed_id);
+        self.vertical_speed = Velocity::new::<foot_per_minute>(vertical_speed);
+        self.true_airspeed = reader.read(&self.true_airspeed_id);
+        self.mach = reader.read(&self.mach_id);
+        self.total_air_temperature = reader.read(&self.total_air_temperature_id);
+        self.angle_of_attack = reader.read(&self.angle_of_attack_id);
+        // Hectopascals, chosen here rather than the generic Pressure
+        // conversion (psi), to match the plugin's ADR physics output.
+        let static_pressure: f64 = reader.read(&self.static_pressure_id);
+        self.static_pressure = Pressure::new::<hectopascal>(static_pressure);
+        self.computed_airspeed = reader.read(&self.computed_airspeed_id);
+    }
+}
