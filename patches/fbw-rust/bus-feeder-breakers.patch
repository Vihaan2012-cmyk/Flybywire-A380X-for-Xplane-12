+    // fbw-xp-systems circuit-breaker workstream: reroute/decouple coverage
+    // for the "AC_ESS_SHED BUS FEED" breaker (patches/fbw-rust/
+    // bus-feeder-breakers.patch), which now ANDs
+    // `ELEC_AC_ESS_SHED_BREAKER_OPEN` into 3XC1's own close_when instead
+    // of bridging `FailureType::ElectricalBus`. AC BUS 1 itself stays
+    // powered in both cases -- only its 3XC1 feed into the AC ESS SHED bus
+    // (400XP, `ElectricalBusType::AlternatingCurrentEssentialShed`) is cut
+    // -- so whether the bus survives is decided entirely by FBW's own
+    // pre-existing 3XC2 transfer logic (`!ac_bus_1_powered ||
+    // overhead.ac_ess_feed_is_altn()`), not by anything authored here.
+    #[test]
+    fn when_ac1_feed_breaker_open_and_altn_selected_gen_4_reroutes_onto_ac_ess_shed_bus() {
+        // Reroute: 3XC1 is forced open by the pulled breaker, but AC BUS 4
+        // is healthy and ALTN is selected, so 3XC2 (its own, unmodified
+        // close_when) picks the AC ESS SHED bus up from engine generator 4
+        // instead of letting it die.
+        let test_bed = test_bed_with()
+            .running_engines()
+            .ac_ess_feed_altn()
+            .and()
+            .ac1_feed_to_ac_ess_shed_breaker_open()
+            .run();
+
+        assert!(test_bed
+            .ac_ess_shed_bus_output()
+            .is_single(PotentialOrigin::EngineGenerator(4)));
+    }
+
+    #[test]
+    fn when_ac1_feed_breaker_open_and_gen_4_also_off_ac_ess_shed_bus_is_unpowered() {
+        // Decouple: same pulled breaker (3XC1 forced open) and ALTN still
+        // selected, but with no engines/APU/external power running at all
+        // (the same cold state `when_ac_bus_1_and_ac_bus_4_are_lost_
+        // neither_ac_ess_feed_contactor_is_closed` above uses), AC BUS 4
+        // has no source of its own either -- so 3XC2's own close_when
+        // condition is never satisfied. The bus genuinely loses power
+        // instead of silently staying alive through some other path.
+        let test_bed = test_bed_with()
+            .ac_ess_feed_altn()
+            .and()
+            .ac1_feed_to_ac_ess_shed_breaker_open()
+            .run();
+
+        assert!(test_bed.ac_ess_shed_bus_output().is_unpowered());
+    }
