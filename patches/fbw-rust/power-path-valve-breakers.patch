+/// Standard compressible (isentropic) flow of an ideal gas through a converging orifice/valve
+/// throat: choked above the critical pressure ratio, subsonic (but still compressible, i.e. not
+/// the incompressible sqrt(dP) form) below it. This is the flow law a real HP/PR/crossbleed/pack
+/// bleed valve obeys; it replaces the crate's `PneumaticContainerConnector` "relax exponentially
+/// toward the equilibrium mass" approximation for the valves this pass converts.
+///
+/// Source: Anderson, *Modern Compressible Flow*, 3rd ed., section 3.6 (isentropic flow through a
+/// converging nozzle); the identical functional form (mass flow ~ discharge coefficient * throat
+/// area * upstream stagnation pressure * f(pressure ratio), choked below the critical ratio) is
+/// the basis of the IEC 60534-2-3 valve gas-sizing standard used for real pneumatic valve Cv/Kv
+/// ratings.
+///
+/// `orifice_area` is the valve's fully-open effective flow area (discharge coefficient is passed
+/// separately so callers can size the two independently, matching how real valve data sheets
+/// separate geometric area from Cd). Returns the (always non-negative) mass flow rate from the
+/// upstream side to the downstream side; the caller is responsible for picking which container is
+/// upstream (this function does not look at which container is "container_one"/"container_two").
+pub fn compressible_orifice_mass_flow_rate(
+    upstream_pressure: Pressure,
+    upstream_temperature: ThermodynamicTemperature,
+    downstream_pressure: Pressure,
+    orifice_area: Area,
+    discharge_coefficient: f64,
+) -> MassRate {
+    use uom::si::mass_rate::kilogram_per_second;
+
+    // Matches PneumaticContainer::HEAT_CAPACITY_RATIO / GAS_CONSTANT_DRY_AIR (private to that
+    // trait, so duplicated here, same as air_cycle_machine.rs already does for CP_AIR/GAMMA/R_AIR).
+    const GAMMA: f64 = 1.4;
+    const R: f64 = 287.057005;
+    // Critical pressure ratio for choked flow: (2/(gamma+1))^(gamma/(gamma-1)), gamma = 1.4.
+    const CRITICAL_PRESSURE_RATIO: f64 = 0.528_281_787_717_685_7;
+
+    let p1 = upstream_pressure.get::<pascal>();
+    let p2 = downstream_pressure.get::<pascal>();
+    let t1 = upstream_temperature.get::<kelvin>().max(1.);
+    let a = orifice_area.get::<square_meter>().max(0.);
+
+    if p1 <= 0. || a <= 0. || p2 >= p1 {
+        return MassRate::default();
+    }
+
+    let pressure_ratio = (p2 / p1).max(0.);
+
+    let flow_function = if pressure_ratio <= CRITICAL_PRESSURE_RATIO {
+        (GAMMA * (2. / (GAMMA + 1.)).powf((GAMMA + 1.) / (GAMMA - 1.))).sqrt()
+    } else {
+        (2. * GAMMA / (GAMMA - 1.)
+            * (pressure_ratio.powf(2. / GAMMA) - pressure_ratio.powf((GAMMA + 1.) / GAMMA)))
+        .max(0.)
+        .sqrt()
+    };
+
+    MassRate::new::<kilogram_per_second>(
+        discharge_coefficient * a * p1 / (R * t1).sqrt() * flow_function,
+    )
