+/// One customer bleed port as the XP port's engine model computes it
+/// (`ENGINE_IP_PORT_PRESSURE_PA:n`/`ENGINE_IP_PORT_TEMP_K:n` for IP8,
+/// `ENGINE_HP_PORT_*` for HP6): the compressor's own total pressure and
+/// temperature there. Until the engine model publishes it (0), the port
+/// falls back to FlyByWire's own N1/N2 estimate.
+#[derive(Clone)]
+struct EnginePort {
+    pressure_id: VariableIdentifier,
+    temperature_id: VariableIdentifier,
+    published: Option<TargetPressureTemperatureSignal>,
+}
+impl EnginePort {
+    fn new(context: &mut InitContext, port: &str, number: usize) -> Self {
+        Self {
+            pressure_id: context.get_identifier(format!("ENGINE_{}_PORT_PRESSURE_PA:{}", port, number)),
+            temperature_id: context.get_identifier(format!("ENGINE_{}_PORT_TEMP_K:{}", port, number)),
+            published: None,
+        }
+    }
+
+    /// The published port conditions, or `estimate`'s when there are none.
+    fn or<'a>(&'a self, estimate: &'a EngineCompressionChamberController) -> PortSignal<'a> {
+        PortSignal(self.published.as_ref(), estimate)
+    }
+}
+impl SimulationElement for EnginePort {
+    fn read(&mut self, reader: &mut SimulatorReader) {
+        let pressure: f64 = systems::simulation::Read::read(reader, &self.pressure_id);
+        let temperature: f64 = systems::simulation::Read::read(reader, &self.temperature_id);
+        self.published = (pressure > 0. && temperature > 0.).then(|| {
+            TargetPressureTemperatureSignal::new(
+                Pressure::new::<pascal>(pressure),
+                ThermodynamicTemperature::new::<kelvin>(temperature),
+            )
+        });
+    }
+}
+
+struct PortSignal<'a>(
+    Option<&'a TargetPressureTemperatureSignal>,
+    &'a EngineCompressionChamberController,
+);
+impl ControllerSignal<TargetPressureTemperatureSignal> for PortSignal<'_> {
+    fn signal(&self) -> Option<TargetPressureTemperatureSignal> {
+        match self.0 {
+            Some(s) => Some(TargetPressureTemperatureSignal::new(
+                s.target_pressure(),
+                s.target_temperature(),
+            )),
+            None => self.1.signal(),
+        }
+    }
+}
+
