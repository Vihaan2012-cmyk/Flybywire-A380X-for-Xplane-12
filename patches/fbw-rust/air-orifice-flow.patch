+    /// the exponential-relaxation-to-equilibrium approximation `update_move_fluid` above uses.
+    /// `orifice_area` is the valve's fully-open effective area; the connector's own
+    /// `transfer_speed_factor` (set via `with_transfer_speed_factor`, the valve's open_amount
+    /// ratio) scales it down the same way every other valve already scales its flow by open
+    /// amount.
+    ///
+    /// An explicit, single-evaluation-per-step orifice equation is only the *instantaneous* rate;
+    /// integrated over a finite step it can overshoot pressure equalisation between two small
+    /// volumes (unlike the old relaxation model, which could not overshoot by construction). The
+    /// same non-negotiable stability bound the old model enforced structurally is kept explicitly
+    /// here: the mass moved this step is clamped to the equilibrium-limited mass
+    /// (`get_mass_flow_for_equilibrium`, already used elsewhere in this crate and unconditionally
+    /// stable/NaN-free). This does not change the flow *law* (still real compressible orifice
+    /// flow away from equilibrium, which is where the choked/unchoked distinction actually
+    /// matters); it only prevents a single large step from reversing the pressure gradient.
+    pub fn update_move_fluid_with_orifice(
+        &mut self,
+        context: &UpdateContext,
+        container_one: &mut impl PneumaticContainer,
+        container_two: &mut impl PneumaticContainer,
+        orifice_area: Area,
+        discharge_coefficient: f64,
+    ) {
+        self.heat_conduction(context, container_one, container_two);
+
+        let dt = context.delta_as_secs_f64();
+        if dt <= 0. {
+            self.fluid_flow = MassRate::default();
+            return;
+        }
+
+        let open_amount = self.transfer_speed_factor.get::<ratio>().clamp(0., 1.);
+        let effective_area = orifice_area * open_amount;
+
+        // `move_mass(container_one, container_two, air_mass)` below ADDS `air_mass` to
+        // container_one (same convention `get_mass_flow_for_equilibrium` already uses) -- so
+        // when container_one is the higher-pressure/upstream side, mass must be REMOVED from it
+        // (negative), not added. (Previous version of this method had this backwards: it added
+        // flow to the upstream/higher-pressure container, which the equilibrium clamp below then
+        // crushed to near nothing -- the actual cause of the PRV-regulation regression this was
+        // reverted for, not the assumed orifice area.)
+        let mut air_mass = if container_one.pressure() >= container_two.pressure() {
+            let rate = compressible_orifice_mass_flow_rate(
+                container_one.pressure(),
+                container_one.temperature(),
+                container_two.pressure(),
+                effective_area,
+                discharge_coefficient,
+            );
+            -Mass::new::<uom::si::mass::kilogram>(rate.get::<uom::si::mass_rate::kilogram_per_second>() * dt)
