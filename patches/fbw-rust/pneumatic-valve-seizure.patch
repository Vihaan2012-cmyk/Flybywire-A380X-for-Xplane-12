+/// A valve seized by a failure: the XP port's `PNEU_VALVE_FAILED:n`, 0
+/// healthy .. 1 fully seized, written every tick from its failure's
+/// magnitude. A seized valve loses that fraction of its authority, measured
+/// from where it stood when it seized: at 1 it no longer moves at all.
+/// Valve numbers: 1-4 engine HP valves, 5-8 engine pressure regulating
+/// (shut-off) valves, 9-11 left/centre/right cross bleed valves, 12 the
+/// APU bleed valve, 13-16 pack 1 flow valves 1/2 and pack 2 flow valves 1/2.
+struct ValveSeizure {
+    failed_id: VariableIdentifier,
+    magnitude: f64,
+    seized_at: Option<Ratio>,
+}
+impl ValveSeizure {
+    fn new(context: &mut InitContext, number: usize) -> Self {
+        Self {
+            failed_id: context.get_identifier(format!("PNEU_VALVE_FAILED:{}", number)),
+            magnitude: 0.,
+            seized_at: None,
+        }
+    }
+
+    /// The open amount the valve may take, given where it stood before this
+    /// tick's command and where the command put it.
+    fn limit(&mut self, before: Ratio, commanded: Ratio) -> Ratio {
+        if self.magnitude <= 0. {
+            self.seized_at = None;
+            return commanded;
+        }
+        let seized = *self.seized_at.get_or_insert(before);
+        seized + (commanded - seized) * (1. - self.magnitude.min(1.))
+    }
+}
+impl SimulationElement for ValveSeizure {
+    fn read(&mut self, reader: &mut SimulatorReader) {
+        let magnitude: f64 = systems::simulation::Read::read(reader, &self.failed_id);
+        self.magnitude = magnitude.clamp(0., 1.);
+    }
+}
+
+/// A fixed open amount, to hold a seized valve where its seizure allows.
+struct HoldOpenAmount(Ratio);
+impl<T: PneumaticValveSignal> ControllerSignal<T> for HoldOpenAmount {
+    fn signal(&self) -> Option<T> {
+        Some(T::new(self.0))
+    }
+}
+
+/// Command `valve` with `controller`, then hold it where `seizure` allows.
+fn update_seizable<T: PneumaticValveSignal, V: ControllablePneumaticValve + ?Sized>(
+    valve: &mut V,
+    open_amount: impl Fn(&V) -> Ratio,
+    controller: &(impl ControllerSignal<T> + ?Sized),
+    seizure: &mut ValveSeizure,
+) {
+    let before = open_amount(valve);
+    valve.update_open_amount(controller);
+    let commanded = open_amount(valve);
+    let allowed = seizure.limit(before, commanded);
+    if allowed != commanded {
+        valve.update_open_amount::<T, _>(&HoldOpenAmount(allowed));
+    }
+}
