+
+        // ATA-29 hydraulics workstream (docs/physics/fluids.md): a
+        // cavitating pump is a real overheat/damage cause on its own, not
+        // only the instructor-triggered `overheat_failure`. Starved of
+        // fluid (low reservoir air pressure, low quantity, or the
+        // reservoir already overheated -- all three already drive
+        // `Pump::cavitation_efficiency` above, via
+        // `PumpCharacteristics::cavitation_efficiency`), the pump's
+        // pistons lose their lubricating film and cavitation bubbles
+        // collapsing against the pump internals both generate real heat:
+        // a standard hydraulic pump failure mode (e.g. Parker Hannifin's
+        // "Cavitation in Hydraulic Pumps" application literature: pump
+        // cavitation "generates heat and can quickly damage a pump").
+        // `CAVITATION_OVERHEAT_EFFICIENCY_RATIO` (0.3) is the severity
+        // threshold below which that starvation counts as a heating
+        // cause -- computed fresh this tick (after `self.pump.update`
+        // above just recomputed it from this tick's reservoir state), not
+        // last tick's stale value.
+        self.heat_state
+            .update(context, self.is_heating_this_tick(pump_speed));
+    }
+
+    /// Whether this tick's conditions should drive `heat_state` toward
+    /// overheat: either the instructor-triggered failure (unchanged, base
+    /// FBW behaviour), or real cavitation (see the comment above the call
+    /// site in `update`) severe enough to cross
+    /// `CAVITATION_OVERHEAT_EFFICIENCY_RATIO`, while the pump is actually
+    /// being asked to pressurise and turning fast enough to matter. Split
+    /// out from `update` so it can be unit tested directly against a
+    /// pump's already-computed cavitation state.
+    fn is_heating_this_tick(&self, pump_speed: AngularVelocity) -> bool {
+        let is_cavitating_badly = self.is_active
+            && self.pump.cavitation_efficiency().get::<ratio>()
+                < Self::CAVITATION_OVERHEAT_EFFICIENCY_RATIO;
+
+        (self.overheat_failure.is_active() || is_cavitating_badly)
+            && pump_speed.get::<revolution_per_minute>() > Self::MIN_SPEED_TO_REPORT_HEATING_RPM
+    }
+
+    pub fn cavitation_efficiency(&self) -> Ratio {
+        self.pump.cavitation_efficiency()
     }
 
