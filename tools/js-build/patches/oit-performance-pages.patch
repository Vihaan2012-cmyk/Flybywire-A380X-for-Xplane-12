@@ -0,0 +1,343 @@
+//  Copyright (c) 2025 FlyByWire Simulations
+//  SPDX-License-Identifier: GPL-3.0
+
+/**
+ * Real data for the OIS FLT OPS performance pages (T.O PERF, LDG PERF).
+ *
+ * Everything here is measured, not assumed:
+ *
+ * - the runway comes from the simulator's own airport facility
+ *   (`LOAD_AIRPORT` on `JS_LISTENER_FACILITY`, answered by the host's
+ *    navigation database), so TORA, the stopway, the displaced threshold,
+ *    both threshold elevations and the runway bearing are the published
+ *    ones;
+ * - the weather comes from the simulator's ambient state (temperature,
+ *   wind and sea level pressure), not from a typed-in guess;
+ * - the weights come from the FQMS (gross weight and centre of gravity) and
+ *   the airframe's zero fuel weight, i.e. from the loadsheet the aircraft
+ *   is actually carrying.
+ *
+ * What is deliberately *not* here: V1/VR/V2, FLEX temperature, the
+ * performance-limited take-off weight, the stabiliser setting and the
+ * take-off/landing distances. Those come from the manufacturer's certified
+ * performance database (the RTOW/LPC data set). FlyByWire ships such a data
+ * set for the A320 only
+ * (`fbw-a32nx/src/systems/shared/src/performance/a32nx_takeoff.ts`); for the
+ * A380-842 `AircraftContext`'s `performanceCalculators.takeoff` is `null`,
+ * and no certified A380 data set is available here. The pages therefore
+ * show those fields as unavailable rather than an approximation: they are
+ * numbers a crew would act on.
+ */
+
+import { Arinc429SignStatusMatrix, Arinc429Word } from '@flybywiresim/fbw-sdk';
+import { maxGw, maxZfw } from '@shared/PerformanceConstants';
+
+/** One MSFS airport runway, as `facility.rs` writes it (`JS_Runway`). */
+export interface OisMsRunway {
+  designation: string;
+  designatorCharPrimary: number;
+  designatorCharSecondary: number;
+  /** Centre of the runway. */
+  latitude: number;
+  longitude: number;
+  /** True bearing of the primary end, degrees. */
+  direction: number;
+  /** Full paved length, metres. */
+  length: number;
+  width: number;
+  surface: number;
+  primaryElevation: number;
+  secondaryElevation: number;
+  primaryThresholdLength: number;
+  secondaryThresholdLength: number;
+  primaryOverrunLength: number;
+  secondaryOverrunLength: number;
+}
+
+/** The airport fields these pages use. */
+export interface OisMsAirport {
+  icao: string;
+  name?: string;
+  lat: number;
+  lon: number;
+  runways: OisMsRunway[];
+}
+
+/** One runway *end*, with the distances a performance page needs. */
+export interface OisRunwayEnd {
+  /** "09L". */
+  ident: string;
+  /** True bearing of this end, degrees. */
+  bearingTrue: number;
+  /** Take-off run available, metres: the paved length from this end. */
+  tora: number;
+  /**
+   * Accelerate-stop distance available, metres: TORA plus this end's
+   * stopway. A clearway is not in the simulator's airport data, so TODA is
+   * not derived here (see `todaKnown`).
+   */
+  asda: number;
+  /** Landing distance available, metres: TORA less the displaced threshold. */
+  lda: number;
+  /** Threshold elevation, feet. */
+  elevationFt: number;
+  /** Runway slope in percent, positive uphill in the direction of take-off. */
+  slopePercent: number;
+  /** Width, metres. */
+  width: number;
+  /** Whether a clearway length was published (it never is, from apt.dat). */
+  todaKnown: boolean;
+}
+
+/** Both ends of every runway at an airport, ready for the page. */
+export function runwayEnds(airport: OisMsAirport): OisRunwayEnd[] {
+  const out: OisRunwayEnd[] = [];
+  for (const rwy of airport.runways ?? []) {
+    const designations = (rwy.designation ?? '').split('-');
+    for (let i = 0; i < 2; i++) {
+      const primary = i === 0;
+      const number = designations[i];
+      if (number === undefined || number === '') {
+        continue;
+      }
+      const designator = designatorChar(primary ? rwy.designatorCharPrimary : rwy.designatorCharSecondary);
+      const ident = `${number.padStart(2, '0')}${designator}`;
+      const thisThreshold = primary ? rwy.primaryThresholdLength : rwy.secondaryThresholdLength;
+      const farOverrun = primary ? rwy.secondaryOverrunLength : rwy.primaryOverrunLength;
+      const thisElevation = primary ? rwy.primaryElevation : rwy.secondaryElevation;
+      const farElevation = primary ? rwy.secondaryElevation : rwy.primaryElevation;
+      // The usable length between the two thresholds, which is what the two
+      // published threshold elevations are measured over.
+      const between = Math.max(1, rwy.length - rwy.primaryThresholdLength - rwy.secondaryThresholdLength);
+      out.push({
+        ident,
+        bearingTrue: primary ? rwy.direction : (rwy.direction + 180) % 360,
+        tora: rwy.length,
+        asda: rwy.length + (farOverrun ?? 0),
+        lda: Math.max(0, rwy.length - (thisThreshold ?? 0)),
+        elevationFt: (thisElevation ?? 0) / 0.3048,
+        slopePercent: ((farElevation - thisElevation) / between) * 100,
+        width: rwy.width,
+        todaKnown: false,
+      });
+    }
+  }
+  out.sort((a, b) => a.ident.localeCompare(b.ident));
+  return out;
+}
+
+/** MSFS `RunwayDesignator` to its letter. */
+function designatorChar(designator: number): string {
+  switch (designator) {
+    case 1:
+      return 'L';
+    case 2:
+      return 'R';
+    case 3:
+      return 'C';
+    case 4:
+      return 'W';
+    case 5:
+      return 'A';
+    case 6:
+      return 'B';
+    default:
+      return '';
+  }
+}
+
+/**
+ * Loads one airport from the simulator's facility database, the same way
+ * every other instrument in this aircraft does: `LOAD_AIRPORT` on the
+ * facility view listener, answered by a `SendAirport` event.
+ *
+ * Resolves with `null` when the airport is not in the database, or when no
+ * answer arrives within `timeoutMs` (the host may still be indexing).
+ */
+export function loadAirport(ident: string, timeoutMs = 10_000): Promise<OisMsAirport | null> {
+  const wanted = ident.trim().toUpperCase();
+  if (wanted.length < 3 || wanted.length > 4) {
+    return Promise.resolve(null);
+  }
+  const icao = `A      ${wanted}`;
+
+  return new Promise((resolve) => {
+    let done = false;
+    const finish = (airport: OisMsAirport | null) => {
+      if (done) {
+        return;
+      }
+      done = true;
+      Coherent.off('SendAirport', receive);
+      clearTimeout(timer);
+      resolve(airport);
+    };
+    const receive = (airport: OisMsAirport) => {
+      if (airport && typeof airport.icao === 'string' && airport.icao.trim().slice(1).trim() === wanted) {
+        finish(airport);
+      }
+    };
+    const timer = setTimeout(() => finish(null), timeoutMs);
+
+    Coherent.on('SendAirport', receive);
+    Coherent.call('LOAD_AIRPORT', icao)
+      .then((found: boolean) => {
+        if (found === false) {
+          finish(null);
+        }
+      })
+      .catch(() => finish(null));
+  });
+}
+
+/** The ambient state the pages use, straight from the simulator. */
+export interface OisWeather {
+  /** Outside air temperature, °C. */
+  oat: number;
+  /** Sea level pressure, hPa. */
+  qnh: number;
+  /** True direction the wind is coming from, degrees. */
+  windDirectionTrue: number;
+  /** Wind speed, knots. */
+  windKt: number;
+}
+
+export function readWeather(): OisWeather {
+  return {
+    oat: SimVar.GetSimVarValue('AMBIENT TEMPERATURE', 'celsius'),
+    qnh: SimVar.GetSimVarValue('SEA LEVEL PRESSURE', 'millibars'),
+    windDirectionTrue: SimVar.GetSimVarValue('AMBIENT WIND DIRECTION', 'degrees'),
+    windKt: SimVar.GetSimVarValue('AMBIENT WIND VELOCITY', 'knots'),
+  };
+}
+
+/** Head- and crosswind on a runway, knots; headwind positive. */
+export function windComponents(
+  runwayBearingTrue: number,
+  weather: OisWeather,
+): { headwind: number; crosswind: number } {
+  const off = ((weather.windDirectionTrue - runwayBearingTrue) * Math.PI) / 180;
+  return {
+    headwind: weather.windKt * Math.cos(off),
+    crosswind: weather.windKt * Math.sin(off),
+  };
+}
+
+/** Pressure altitude of a point at `elevationFt` under `qnh`, feet. */
+export function pressureAltitude(elevationFt: number, qnh: number): number {
+  return elevationFt + (1013.25 - qnh) * 27;
+}
+
+/** ISA temperature at a pressure altitude, °C. */
+export function isaTemperature(pressureAltFt: number): number {
+  return 15 - 0.0019812 * pressureAltFt;
+}
+
+/**
+ * One ARINC 429 local variable, or `null` when its sign status matrix says
+ * the value must not be used: a page shows a dash rather than the stale
+ * number behind a failed or unfunctional word.
+ */
+export function arincValue(name: string): number | null {
+  const word = Arinc429Word.fromSimVarValue(name);
+  return word.ssm === Arinc429SignStatusMatrix.NormalOperation ? word.value : null;
+}
+
+/** The weights the loadsheet and the fuel system actually hold. */
+export interface OisWeights {
+  /** Gross weight from the FQMS, kg; null when the FQMS has no valid data. */
+  grossWeightKg: number | null;
+  /** Centre of gravity from the FQMS, % MAC; null when invalid. */
+  cgPercentMac: number | null;
+  /** Fuel on board from the FQMS, kg; null when invalid. */
+  fobKg: number | null;
+  /** Zero fuel weight from the airframe's loadsheet, kg. */
+  zeroFuelWeightKg: number;
+  /** Zero fuel weight centre of gravity, % MAC. */
+  zeroFuelCgPercentMac: number;
+}
+
+export function readWeights(): OisWeights {
+  return {
+    grossWeightKg: arincValue('L:A32NX_FQMS_GROSS_WEIGHT'),
+    cgPercentMac: arincValue('L:A32NX_FQMS_CENTER_OF_GRAVITY_MAC'),
+    fobKg: arincValue('L:A32NX_FQMS_TOTAL_FUEL_ON_BOARD'),
+    zeroFuelWeightKg: SimVar.GetSimVarValue('L:A32NX_AIRFRAME_ZFW', 'number'),
+    zeroFuelCgPercentMac: SimVar.GetSimVarValue('L:A32NX_AIRFRAME_ZFW_CG_PERCENT_MAC', 'number'),
+  };
+}
+
+/**
+ * The A380-842 structural weight limits this aircraft is configured with
+ * (`@shared/PerformanceConstants`, which the FMS itself validates entries
+ * against). Structural limits are airframe constants, not a performance
+ * computation, so they are shown as read.
+ *
+ * There is no maximum *landing* weight constant in that file, so the
+ * landing page shows the landing-weight limit as unavailable rather than
+ * inventing one.
+ */
+export const A380_MAX_ZFW_KG = maxZfw;
+export const A380_MAX_GW_KG = maxGw;
+
+/** The unit set the OPTIONS panel of a performance page holds. */
+export interface OisUnits {
+  /** 't' (metric tonnes) or 'klb' (thousands of pounds). */
+  weight: 't' | 'klb';
+  /** 'hpa' or 'inhg'. */
+  altimeter: 'hpa' | 'inhg';
+  /** 'm' or 'ft'. */
+  distance: 'm' | 'ft';
+}
+
+export const DEFAULT_UNITS: OisUnits = { weight: 't', altimeter: 'hpa', distance: 'm' };
+
+export const M_TO_FT = 1 / 0.3048;
+export const KG_TO_LB = 2.20462262;
+
+/** A weight in kg as the OPTIONS weight unit, one decimal. */
+export function formatWeight(kg: number | null, units: OisUnits): string {
+  if (kg === null || !Number.isFinite(kg)) {
+    return '---.-';
+  }
+  return (units.weight === 't' ? kg / 1000 : (kg * KG_TO_LB) / 1000).toFixed(1);
+}
+
+export function weightUnitLabel(units: OisUnits): string {
+  return units.weight === 't' ? 'T' : 'KLB';
+}
+
+/** A distance in metres as the OPTIONS distance unit, whole units. */
+export function formatDistance(metres: number | null, units: OisUnits): string {
+  if (metres === null || !Number.isFinite(metres)) {
+    return '----';
+  }
+  return Math.round(units.distance === 'm' ? metres : metres * M_TO_FT).toFixed(0);
+}
+
+export function distanceUnitLabel(units: OisUnits): string {
+  return units.distance === 'm' ? 'M' : 'FT';
+}
+
+/** A pressure in hPa as the OPTIONS altimeter unit. */
+export function formatPressure(hpa: number, units: OisUnits): string {
+  if (!Number.isFinite(hpa)) {
+    return '----';
+  }
+  return units.altimeter === 'hpa' ? Math.round(hpa).toFixed(0) : (hpa * 0.0295299830714).toFixed(2);
+}
+
+export function pressureUnitLabel(units: OisUnits): string {
+  return units.altimeter === 'hpa' ? 'HPA' : 'IN HG';
+}
+
+/** What every computed-but-unavailable performance field shows. */
+export const UNAVAILABLE = 'NOT AVAIL';
+
+/**
+ * Why the certified results are unavailable, shown on the page so the crew
+ * is never left guessing whether a blank field is a failure or a gap.
+ */
+export const UNAVAILABLE_REASON =
+  'NO CERTIFIED A380-842 TAKE-OFF/LANDING PERFORMANCE DATA SET IS INSTALLED. ' +
+  'THE COMPUTED RESULTS BELOW ARE NOT AVAILABLE AND MUST BE TAKEN FROM THE QRH OR THE AIRLINE PERFORMANCE TOOL.';
